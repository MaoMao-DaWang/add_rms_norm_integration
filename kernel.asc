#include <cstdint>
#include "kernel_operator.h"
#include "acl/acl.h"
#include "launch.h"

constexpr uint32_t ARM_TILE = 2048;

struct ArmPlan {
    uint32_t rows;
    uint32_t cols;
    uint32_t rowsPerCore;
    float epsilon;
    float invCols;
    int32_t modelCompatible;
};

template <typename T>
struct ArmConvert {
    __aicore__ static inline void In(const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<T>& src, uint32_t count)
    {
        AscendC::Cast(dst, src, AscendC::RoundMode::CAST_NONE, count);
    }

    __aicore__ static inline void Out(const AscendC::LocalTensor<T>& dst,
        const AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::Cast(dst, src, AscendC::RoundMode::CAST_RINT, count);
    }
};

template <>
struct ArmConvert<float> {
    __aicore__ static inline void In(const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::DataCopy(dst, src, ((count + 7) / 8) * 8);
    }

    __aicore__ static inline void Out(const AscendC::LocalTensor<float>& dst,
        const AscendC::LocalTensor<float>& src, uint32_t count)
    {
        AscendC::DataCopy(dst, src, ((count + 7) / 8) * 8);
    }
};

template <typename T>
class ArmKernel {
public:
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR gamma,
        GM_ADDR y, GM_ADDR rstd, GM_ADDR x, const ArmPlan& plan,
        AscendC::TPipe* pipe)
    {
        p = plan;
        x1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
        x2Gm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
        gammaGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(gamma));
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y));
        rstdGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(rstd));
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x));

        const uint32_t rowBytes = ((p.cols + 7) / 8) * 32;
        pipe->InitBuffer(inputQueue, 1, ARM_TILE * sizeof(T));
        pipe->InitBuffer(outputQueue, 1, ARM_TILE * sizeof(T));
        pipe->InitBuffer(rstdQueue, 1, 32);
        pipe->InitBuffer(rowBuffer, rowBytes);
        pipe->InitBuffer(gammaBuffer, rowBytes);
        pipe->InitBuffer(aBuffer, ARM_TILE * sizeof(float));
        pipe->InitBuffer(bBuffer, ARM_TILE * sizeof(float));
        pipe->InitBuffer(reduceScratch, ARM_TILE * sizeof(float));
        pipe->InitBuffer(reducedBuffer, 32);
        pipe->InitBuffer(oneBuffer, 32);
        pipe->InitBuffer(roundBuffer, ARM_TILE * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        const uint32_t begin = AscendC::GetBlockIdx() * p.rowsPerCore;
        if (begin >= p.rows) return;
        uint32_t end = begin + p.rowsPerCore;
        if (end > p.rows) end = p.rows;

        auto weights = gammaBuffer.Get<float>();
        auto ones = oneBuffer.Get<float>();
        AscendC::Duplicate(ones, 1.0f, 8);
        AscendC::PipeBarrier<PIPE_V>();
        for (uint32_t col = 0; col < p.cols; col += ARM_TILE) {
            Load(weights[col], gammaGm, col, Width(col));
        }

        auto values = rowBuffer.Get<float>();
        auto a = aBuffer.Get<float>();
        auto b = bBuffer.Get<float>();
        auto reduced = reducedBuffer.Get<float>();
        auto scratch = reduceScratch.Get<float>();
        for (uint32_t row = begin; row < end; ++row) {
            const uint64_t base = static_cast<uint64_t>(row) * p.cols;
            float meanSquare = 0.0f;
            for (uint32_t col = 0; col < p.cols; col += ARM_TILE) {
                const uint32_t count = Width(col);
                Load(a, x1Gm, base + col, count);
                Load(b, x2Gm, base + col, count);
                // Keep the unrounded residual for both the reduction and y.
                AscendC::Add(values[col], a, b, count);
                AscendC::PipeBarrier<PIPE_V>();
                if (p.modelCompatible && sizeof(T) != sizeof(float)) {
                    RoundToInput(values[col], count);
                }
                Store(xGm, base + col, values[col], count);

                AscendC::Mul(a, values[col], values[col], count);
                AscendC::PipeBarrier<PIPE_V>();
                // The reference scales each square BEFORE summation.
                AscendC::Muls(a, a, p.invCols, count);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::ReduceSum(reduced, a, scratch, count);
                AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
                meanSquare += reduced.GetValue(0);
                AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
            }

            auto stat = rstdQueue.AllocTensor<float>();
            AscendC::Duplicate(stat, meanSquare + p.epsilon, 8);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sqrt(stat, stat, 8);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Div(stat, ones, stat, 8);
            AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            const float scale = stat.GetValue(0);
            AscendC::SetFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::S_V>(EVENT_ID0);
            rstdQueue.EnQue(stat);
            stat = rstdQueue.DeQue<float>();
            AscendC::DataCopyExtParams statCopy = {1, sizeof(float), 0, 0, 0};
            AscendC::DataCopyPad(rstdGm[row], stat, statCopy);
            rstdQueue.FreeTensor(stat);

            for (uint32_t col = 0; col < p.cols; col += ARM_TILE) {
                const uint32_t count = Width(col);
                // Preserve the reference's two separate FP32 multiplications.
                AscendC::Muls(a, values[col], scale, count);
                AscendC::PipeBarrier<PIPE_V>();
                if (p.modelCompatible && sizeof(T) != sizeof(float)) {
                    RoundToInput(a, count);
                }
                AscendC::Mul(a, a, weights[col], count);
                AscendC::PipeBarrier<PIPE_V>();
                Store(yGm, base + col, a, count);
            }
        }
    }

private:
    __aicore__ inline void RoundToInput(const AscendC::LocalTensor<float>& values,
        uint32_t count)
    {
        auto raw = roundBuffer.Get<T>();
        ArmConvert<T>::Out(raw, values, count);
        AscendC::PipeBarrier<PIPE_V>();
        ArmConvert<T>::In(values, raw, count);
        AscendC::PipeBarrier<PIPE_V>();
    }

    __aicore__ inline uint32_t Width(uint32_t col)
    {
        const uint32_t left = p.cols - col;
        return left < ARM_TILE ? left : ARM_TILE;
    }

    __aicore__ inline void Load(const AscendC::LocalTensor<float>& dst,
        const AscendC::GlobalTensor<T>& src, uint64_t offset, uint32_t count)
    {
        auto raw = inputQueue.AllocTensor<T>();
        AscendC::DataCopyExtParams copy = {
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> pad = {false, 0, 0, 0};
        AscendC::DataCopyPad(raw, src[offset], copy, pad);
        inputQueue.EnQue(raw);
        raw = inputQueue.DeQue<T>();
        ArmConvert<T>::In(dst, raw, count);
        AscendC::PipeBarrier<PIPE_V>();
        inputQueue.FreeTensor(raw);
    }

    __aicore__ inline void Store(const AscendC::GlobalTensor<T>& dst,
        uint64_t offset, const AscendC::LocalTensor<float>& src, uint32_t count)
    {
        auto raw = outputQueue.AllocTensor<T>();
        ArmConvert<T>::Out(raw, src, count);
        outputQueue.EnQue(raw);
        raw = outputQueue.DeQue<T>();
        AscendC::DataCopyExtParams copy = {
            1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(dst[offset], raw, copy);
        outputQueue.FreeTensor(raw);
        // The next operation may overwrite the FP32 source of the conversion.
        AscendC::PipeBarrier<PIPE_V>();
    }

    ArmPlan p;
    AscendC::GlobalTensor<T> x1Gm, x2Gm, gammaGm, yGm, xGm;
    AscendC::GlobalTensor<float> rstdGm;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> inputQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> outputQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> rstdQueue;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> rowBuffer, gammaBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> aBuffer, bBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> reduceScratch, reducedBuffer, oneBuffer;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> roundBuffer;
};

template <typename T>
__global__ __vector__ void add_rms_norm_custom(GM_ADDR x1, GM_ADDR x2,
    GM_ADDR gamma, GM_ADDR y, GM_ADDR rstd, GM_ADDR x, ArmPlan p)
{
    AscendC::TPipe pipe;
    ArmKernel<T> kernel;
    kernel.Init(x1, x2, gamma, y, rstd, x, p, &pipe);
    kernel.Process();
}

extern "C" void arm_launch(void* x1, void* x2, void* gamma,
    void* y, void* rstd, void* residual, uint32_t rows, uint32_t cols,
    int32_t dtype, uint32_t cores, float epsilon, int32_t modelCompatible,
    void* stream)
{
    using namespace AscendC;
    ArmPlan p{};
    p.cols = cols;
    p.rows = rows;
    p.epsilon = epsilon;
    p.invCols = 1.0f / static_cast<float>(cols);
    p.modelCompatible = modelCompatible;
    if (cores > rows) cores = rows;
    p.rowsPerCore = ((rows + cores - 1) / cores + 31) / 32 * 32;
    cores = (rows + p.rowsPerCore - 1) / p.rowsPerCore;
    auto a = reinterpret_cast<GM_ADDR>(x1);
    auto b = reinterpret_cast<GM_ADDR>(x2);
    auto g = reinterpret_cast<GM_ADDR>(gamma);
    auto out = reinterpret_cast<GM_ADDR>(y);
    auto stat = reinterpret_cast<GM_ADDR>(rstd);
    auto sum = reinterpret_cast<GM_ADDR>(residual);
    auto aclStream = reinterpret_cast<aclrtStream>(stream);
    if (dtype == 0) {
        add_rms_norm_custom<float><<<cores, nullptr, aclStream>>>(a, b, g, out, stat, sum, p);
    } else if (dtype == 1) {
        add_rms_norm_custom<half><<<cores, nullptr, aclStream>>>(a, b, g, out, stat, sum, p);
    } else if (dtype == 2) {
        add_rms_norm_custom<bfloat16_t><<<cores, nullptr, aclStream>>>(a, b, g, out, stat, sum, p);
    }
}
